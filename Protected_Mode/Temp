fun_print_hex_32:
    push eax
    push ecx
    push edx

    mov edx,ebx
    mov ebx,hex_start
    call fun_print_32
    mov ebx,[data_temp_pos]

.repeat:
    ;Disassemble the txt to single charater
    mov ax,dx

    cmp al,0x10
    jl .integer
    add al,0x07
.integer:
    add al,0x30
    mov [ebx],al
    inc [ebx]
    shr dx,1
    
.exit:
    pop edx
    pop ecx
    pop eax
ret
