[BITS 16]
[org 0x7c00]

cli ;Disabled Interrupts

;Enable Address Lines A20 to access more memory

in al, 0x92 ; Reads 1 byte from the hardware port
or al, 2
out 0x92, al ; Send the address to the port 0x92

xor ax,ax
mov es,ax
mov bx,0x1000

;Loading Kernel from the disk..
;reads 4 sectors from sector 2 to 0x1000

mov ah,0x02
mov al,4
mov ch,0
mov cl,2
mov dh,0
mov dl,0x80

;mov bx,0x1000

int 0x13

jc disk_error

lgdt [gdt_descriptor]

mov eax,cr0
or eax,1
mov cr0,eax

jmp 0x08: protected_mode


gdt_start:

gdt_null:
dq 0		;Intialize QuadWord(8 bytes)  to 0

gdt_code:
	dw 0xFFFF
	dw 0x0000
	db 0x00
	db 10011010b
	db 11001111b
	db 0x00

gdt_data:
	dw 0xFFFF
	dw 0x0000
	db 0x00
	db 10010010b
	db 11001111b
	db 0x00

gdt_end:

gdt_descriptor:
	dw gdt_end - gdt_start - 1
	dd gdt_start


[BITS 32]

protected_mode:

mov ax,0x10
mov ds,ax
mov es,ax
mov fs,ax
mov gs,ax
mov ss,ax


mov esp, 0x900000
mov ebp,esp

jmp 0x1000

; Disk Error

[BITS 16]

disk_error:
    mov ah, 0x0E
    mov al, 'E'
    int 0x10

    mov al, ah   ; error code
    add al, '0'
    int 0x10
    mov al, dl
    add al, '0'
    mov ah, 0x0E
    int 0x10
    mov si,error_msg
.print:
    lodsb
    or al,al
    jz $
    
    mov ah,0x0E
    int 0x10

    jmp .print

error_msg db "Disk Error!",0

times 510 - ($-$$) db 0
dw 0xAA55
